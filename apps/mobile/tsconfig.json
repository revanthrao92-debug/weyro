{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["react-native"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "react-native-maps": ["./src/types/react-native-maps.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
