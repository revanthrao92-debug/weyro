{
  "expo": {
    "name": "weyro",
    "slug": "weyro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "weyro",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.weyro.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Weyro requires camera access so you can photograph damaged vehicle parts for quotes.",
        "NSPhotoLibraryUsageDescription": "Weyro requires photo library access to upload images of damaged vehicle parts."
      }
    },
    "android": {
      "package": "com.weyro.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Weyro needs access to your photos so you can upload images of damaged vehicle parts.",
          "cameraPermission": "Weyro needs access to your camera so you can take photos of damaged vehicle parts."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Weyro uses your location to match your repair request with nearby workshops and parts dealers."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e31c0a35-add9-4155-b4d8-63be55f1556e"
      }
    },
    "owner": "revanthrao22"
  }
}
