{
  "expo": {
    "name": "weyro",
    "slug": "weyro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "weyro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.weyro.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Weyro requires camera access so you can photograph damaged vehicle parts for quotes.",
        "NSPhotoLibraryUsageDescription": "Weyro requires photo library access to upload vehicle damage photos."
      }
    },
    "android": {
      "package": "com.weyro.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Weyro needs access to your photos so you can upload images of damaged vehicle parts.",
          "cameraPermission": "Weyro needs access to your camera so you can take photos of damaged vehicle parts."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Weyro uses your location to match your repair request with nearby workshops and parts dealers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
