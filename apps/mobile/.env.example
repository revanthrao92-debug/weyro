# API base URL for the mobile app (required for device builds; localhost
# only works on the Expo web preview / simulator where 127.0.0.1 == desktop).
# EXPO_PUBLIC_API_URL=https://your-api.example.com/api/v1

# Mapbox (interactive maps, address search, routing).
# Public token — restrict it in the Mapbox dashboard to:
#   • your iOS bundle id and Android package (com.weyro.app)
#   • styles:tiles + geocoding + directions endpoints
# Never place a secret `sk.` token here.
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the dark style (defaults to mapbox/dark-v11).
# EXPO_PUBLIC_MAPBOX_STYLE=mapbox/dark-v11
