# Weyro Backend API Environment Configuration

# Application
NODE_ENV=development
PORT=4000

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://weyro:weyro_dev_password@localhost:5432/weyro_db?schema=public

# JWT Authentication
JWT_ACCESS_SECRET=weyro_dev_jwt_access_secret_super_key_32_chars
JWT_REFRESH_SECRET=weyro_dev_jwt_refresh_secret_super_key_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,http://localhost:8082

# Storage Driver (local or s3)
STORAGE_DRIVER=local
STORAGE_BUCKET=weyro-uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payments - Razorpay (INR)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
