# Weyro Backend API Environment Configuration

# Application
NODE_ENV=development
PORT=4000

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://weyro:weyro_dev_password@localhost:5432/weyro_db?schema=public

# JWT Authentication
JWT_ACCESS_SECRET=weyro_dev_jwt_access_secret_super_key_32_chars
JWT_REFRESH_SECRET=weyro_dev_jwt_refresh_secret_super_key_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,http://localhost:8082

# Storage Driver (local or s3)
STORAGE_DRIVER=local
STORAGE_BUCKET=weyro-uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payments - Razorpay (INR)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Direct connection for migrations (same as DATABASE_URL for local docker)
DIRECT_URL=postgresql://weyro:weyro_dev_password@localhost:5432/weyro_db?schema=public

# !!! COMMITTED DEV SECRETS MUST NEVER REACH PRODUCTION !!!
# Rotate every secret below before any production deployment and source
# them from a secret manager, not a committed .env.

# OTP security
# HMAC-SHA256 secret used to hash OTP codes at rest. REQUIRED in production
# (dev default is rejected by env validation): generate with
#   openssl rand -hex 32
OTP_HASH_SECRET=weyro_dev_otp_hash_secret_32_chars_x

# SMS provider for OTP delivery: console (dev only), msg91, or twilio.
# A real provider with credentials is REQUIRED in production.
SMS_PROVIDER=console
SMS_MSG91_AUTH_KEY=
SMS_MSG91_SENDER_ID=WEYRO
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=

# Proxy trust — M1: set to the NUMBER of trusted proxy hops in front of the
# API (e.g. 1 behind a typical LB). "true" (trust every hop) is rejected in
# production because it lets clients defeat per-IP rate limiting.
TRUST_PROXY=

# Prisma connection pool (M6)
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT=10

# Private-bucket presigned GET lifetime (seconds), default 7 days
STORAGE_SIGNED_URL_TTL_SECONDS=604800
