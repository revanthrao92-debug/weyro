{
  "name": "weyro",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@expo/ui": "~57.0.25",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@weyro/api-contracts": "*",
    "@weyro/validation": "*",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "db:generate": "npm run db:generate -w @weyro/database",
    "db:migrate": "npm run db:migrate -w @weyro/database",
    "db:seed": "npm run db:seed -w @weyro/database",
    "build:packages": "npm run build -w @weyro/api-contracts && npm run build -w @weyro/validation && npm run build -w @weyro/database",
    "build:api": "npm run build -w @weyro/api",
    "build": "npm run build:packages && npm run build:api",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "npm run test -w @weyro/api",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit && npm run typecheck -w @weyro/api-contracts && npm run typecheck -w @weyro/validation && npm run typecheck -w @weyro/database && npm run typecheck -w @weyro/api",
    "doctor": "npx expo-doctor"
  },
  "private": true
}
